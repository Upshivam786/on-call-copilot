# On-Call Copilot Environment Configuration
# Copy to .env and fill in your values

# =============================================================================
# Environment
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# =============================================================================
# Database (PostgreSQL + pgvector)
# =============================================================================
# Local (Docker Compose)
DATABASE_URL=postgresql+asyncpg://oncall:oncall_dev_password@localhost:5432/oncall_copilot
# Production example:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname?sslmode=require

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# OpenAI (for embeddings + LLM)
# =============================================================================
OPENAI_API_KEY=sk-your-openai-key-here
# Optional: override default models
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_MODEL=gpt-4o-mini

# =============================================================================
# Alternative: Local embeddings via Ollama (uncomment to use)
# =============================================================================
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=bge-small-en
# EMBEDDING_DIMENSIONS=384
# LLM_MODEL=llama3.1:8b

# =============================================================================
# PagerDuty (for incident ingestion)
# =============================================================================
PAGERDUTY_API_KEY=your-pagerduty-api-key
PAGERDUTY_SUBDOMAIN=your-subdomain

# =============================================================================
# GitHub (for postmortem/runbook ingestion)
# =============================================================================
GITHUB_TOKEN=ghp_your-github-token
GITHUB_ORG=your-org
GITHUB_REPO=your-runbooks-repo

# =============================================================================
# Langfuse (observability - optional)
# =============================================================================
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# =============================================================================
# Kubernetes (for query_k8s tool - optional)
# =============================================================================
# KUBECONFIG_PATH=/path/to/kubeconfig
# Or use in-cluster config when running in K8s

# =============================================================================
# Application Settings
# =============================================================================
# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Retrieval
RETRIEVAL_TOP_K=20
RETRIEVAL_RERANK_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.7

# Agent
AGENT_MAX_TURNS=8
AGENT_TIMEOUT_SECONDS=30

# Ingestion
INGESTION_BATCH_SIZE=100
INGESTION_CHUNK_SIZE=512
INGESTION_CHUNK_OVERLAP=50

# UI
UI_PORT=8501